{
  "schema_version": 1,
  "quilt_loader": {
    "group": "org.uee",
    "id": "uee",
    "version": "${version}",
    "metadata": {
      "name": "Universal Element Exporter",
      "description": "Multi-loader element exporter for Minecraft. Exports mod metadata, registries, datapack contents and game assets in one configurable pass, as machine-readable artifacts for automation such as wiki editing workflows.",
      "contributors": {
        "houyangbaoxin2009": "Owner"
      },
      "contact": {
        "homepage": "https://github.com/houyangbaoxin2009/uee",
        "sources": "https://github.com/houyangbaoxin2009/uee"
      },
      "license": "TPL-2.3"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "org.uee.quilt.UeeQuilt"
      ],
      "client_init": [
        "org.uee.quilt.UeeQuiltClient"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.26.0"
      },
      {
        "id": "minecraft",
        "versions": ">=1.21.1 <1.21.2"
      }
    ]
  }
}
